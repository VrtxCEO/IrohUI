{
  "redirects": [
    { "source": "/manifesto", "destination": "https://www.omni-ouro.com/manifesto", "permanent": true },
    { "source": "/app", "destination": "/app/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/app/", "destination": "/app/index.html" },
    { "source": "/((?!api/|app/).*)", "destination": "/index.html" }
  ]
}
